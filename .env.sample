# MariaDB connection (overridden by dbconnect.conf if present)
DB_HOST=192.168.0.80
DB_PORT=3306
DB_NAME=youless-smigp1
DB_USER=root
DB_PASS=Piwo1907

# Query window (defaults)
LOOKBACK_DAYS=7
EVENT_WATT_THRESHOLD=500
MIN_EVENT_DURATION_MIN=2
MAX_EVENT_DURATION_MIN=240

# Set MOCK_DB=1 to generate synthetic data (no MariaDB needed)
MOCK_DB=0

# Schema mapping (optioneel aanpassen aan jouw tabel/kolomnamen)
TABLE_NAME=meterstanden
TIME_COLUMN=time
CONSUME_COLS=p1,p2
EXPORT_COLS=n1,n2
PHASE_KWH_COLS=L1_kwh,L2_kwh,L3_kwh
