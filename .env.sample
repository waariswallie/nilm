# MariaDB connection (overridden by dbconnect.conf if present)
DB_HOST=192.168.0.80
DB_PORT=3306
DB_NAME=youless-smigp1
DB_USER=root
DB_PASS=Piwo1907

# Query window (defaults) 
LOOKBACK_DAYS=7
EVENT_WATT_THRESHOLD=650
MIN_EVENT_DURATION_MIN=3
MAX_EVENT_DURATION_MIN=240

# Set MOCK_DB=1 to generate synthetic data (no MariaDB needed)
MOCK_DB=0

# Schema mapping (optioneel aanpassen aan jouw tabel/kolomnamen)
TABLE_NAME=meterstanden
TIME_COLUMN=time
CONSUME_COLS=p1,p2
EXPORT_COLS=n1,n2
PHASE_KWH_COLS=L1_kwh,L2_kwh,L3_kwh

# Scheduling / performance (optioneel)
# NICE_LEVEL=-5        # hogere prioriteit (root nodig voor <0)
# CPU_AFFINITY=0,1     # beperk cores
HIGHRES_INTERVAL_SECONDS=10
HIGHRES_TABLE=your_highres_table          # vervang door echte tabelnaam
HIGHRES_TIME_COLUMN=ts
HIGHRES_PHASE_COLS=L1,L2,L3
# HIGHRES_POWER_COL=Pnet                  # alleen als je al een total hebt
